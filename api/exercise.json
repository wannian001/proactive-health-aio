 29}, {"start": "2026-10-11T11:50", "end": "2026-10-11T12:44", "minutes": 54}, {"start": "2026-10-11T14:00", "end": "2026-10-11T14:30", "minutes": 30}, {"start": "2026-10-11T15:56", "end": "2026-10-11T17:27", "minutes": 91}, {"start": "2026-10-11T18:03", "end": "2026-10-11T18:17", "minutes": 14}, {"start": "2026-10-11T18:25", "end": "2026-10-11T18:58", "minutes": 33}, {"start": "2026-10-11T22:27", "end": "2026-10-11T22:32", "minutes": 5}, {"start": "2026-10-11T23:20", "end": "2026-10-12T00:30", "minutes": 70}]}, {"date": "2026-10-12", "longest": 77, "long": 1, "total": 218, "stretches": [{"start": "2026-10-12T00:36", "end": "2026-10-12T01:06", "minutes": 30}, {"start": "2026-10-12T09:00", "end": "2026-10-12T10:17", "minutes": 77}, {"start": "2026-10-12T12:11", "end": "2026-10-12T12:51", "minutes": 40}, {"start": "2026-10-12T14:01", "end": "2026-10-12T14:18", "minutes": 17}, {"start": "2026-10-12T14:49", "end": "2026-10-12T15:07", "minutes": 18}, {"start": "2026-10-12T15:16", "end": "2026-10-12T15:23", "minutes": 7}, {"start": "2026-10-12T15:54", "end": "2026-10-12T16:03", "minutes": 9}, {"start": "2026-10-12T17:06", "end": "2026-10-12T17:14", "minutes": 8}, {"start": "2026-10-12T17:37", "end": "2026-10-12T17:49", "minutes": 12}]}], "usual": 96.0, "live": {"since": "2026-10-12T17:45", "seen": "2026-10-12T18:39", "minutes": 55}, "routines": ["doorway_chest", "chin_tuck", "thoracic_extension", "walk_break"], "info": {"doorway_chest": {"minutes": 2, "regions": ["chest"], "zh": {"name": "门框拉伸胸前", "how": "站在门框里，前臂贴住门框两侧，手肘和肩差不多高。一只脚向前迈小半步，身体前倾，直到胸前轻轻被拉开。", "dose": "30 秒，2 次"}, "en": {"name": "Doorway chest stretch", "how": "Stand in a doorway with your forearms on the frame, elbows about shoulder height. Step one foot forward a little and lean in until the front of your chest feels a light stretch.", "dose": "30 seconds, twice"}}, "chin_tuck": {"minutes": 1, "regions": ["neck"], "zh": {"name": "收下巴", "how": "坐直，眼睛平视。下巴水平往后收，像要做出双下巴，后颈被拉长；不要低头。停 3 秒再放松。", "dose": "10 次"}, "en": {"name": "Chin tucks", "how": "Sit tall and look straight ahead. Slide your chin straight back, as if making a double chin, so the back of your neck lengthens; don't nod down. Hold 3 seconds, then relax.", "dose": "10 times"}}, "thoracic_extension": {"minutes": 1, "regions": ["upper_back", "chest"], "zh": {"name": "坐姿胸椎伸展", "how": "坐在有靠背的椅子上，双手抱在脑后。以椅背上沿为支点，上背慢慢向后仰，眼睛看向天花板，再回来。腰不用力。", "dose": "8–10 次"}, "en": {"name": "Seated upper-back extension", "how": "Sit on a chair with a backrest, hands behind your head. Using the top of the backrest as a hinge, lean your upper back slowly back, eyes to the ceiling, then come back up. Keep your lower back relaxed.", "dose": "8–10 times"}}, "walk_break": {"minutes": 2, "regions": [], "zh": {"name": "起来走两分钟", "how": "站起来，去倒杯水、走一圈楼道或者在屋里走走，顺便看看远处。", "dose": "2–3 分钟"}, "en": {"name": "Get up and walk for two minutes", "how": "Stand up, fetch a glass of water or walk a lap of the corridor or the room, and look at something far away.", "dose": "2–3 minutes"}}}, "stop": {"zh": "应该只是轻微的拉伸感，不疼。出现麻木、刺痛、往手臂或腿放射的痛、头晕，或者疼痛越来越重、夜里痛醒、是受伤之后开始的，先停下，去看医生或物理治疗师。", "en": "It should feel like a light stretch, never pain. If you get numbness, pins and needles, pain spreading into an arm or leg, dizziness, or pain that keeps getting worse, wakes you at night or started with an injury, stop and see a doctor or physiotherapist."}, "rule": {"break_min": 5, "long_min": 50, "repeat_min": 30, "base_days": 28, "computers": ["laptop", "desktop"]}}, "has_data": true, "rule": {"window": 7, "baseline": 28, "min_total_days": 5, "weeks": 12, "response_days": 120, "min_response": 4}}